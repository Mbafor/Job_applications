# Copy to .env for local testing only. In GitHub Actions these are injected
# as repo secrets (Settings -> Secrets and variables -> Actions) - never commit .env.
#
# NOTE: there is intentionally no LinkedIn credential/session/cookie variable
# here or anywhere in this codebase. The LinkedIn scraper runs logged-out only.

# --- Supabase (Settings -> API in your Supabase project) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (https://console.anthropic.com/settings/keys) ---
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=your-resend-api-key

# --- Adzuna fallback source (https://developer.adzuna.com/) ---
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
# Adzuna is country-scoped. Pick the country whose listings you want as fallback:
# us, gb, at, au, br, ca, de, fr, in, it, mx, nl, pl, sg, za
ADZUNA_COUNTRY=us
