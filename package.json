{
  "name": "job-application-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Automated job discovery + resume tailoring pipeline (scrape -> dedupe -> tailor -> PDF -> upload -> email digest). Submission is always manual.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "ts-node src/index.ts",
